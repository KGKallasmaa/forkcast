GEMINI_API_KEY= your_gemini_api_key_here
# Web Search mode only. Tavily is used whenever TAVILY_API_KEY is set.
TAVILY_API_KEY= your_tavily_api_key_here
# Without a Tavily key, Web Search falls back to Keenable (docs.keenable.ai):
# set KEENABLE_API_KEY, or KEENABLE_KEYLESS=true to use the keyless endpoints
# (rate limited per IP). Keyed and keyless requests are both logged under
# Keenable's default data policy (docs.keenable.ai/data-privacy).
# KEENABLE_API_KEY=
# KEENABLE_KEYLESS=true
PORT=3001